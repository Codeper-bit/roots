# Base URL of the Roots FastAPI backend.
# Default (used when this variable is not set): http://127.0.0.1:8000
#
# The backend currently has no CORS middleware. Either add CORSMiddleware to
# backend/app/main.py, or route requests through the Vite dev proxy:
#   VITE_API_BASE_URL=/api
VITE_API_BASE_URL=http://127.0.0.1:8000
